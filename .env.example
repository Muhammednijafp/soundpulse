# ===================================================
# SoundPulse Backend Configuration Template
# Local: copy to .env. Render: set these in Dashboard > Environment.
# NEVER commit real .env (gitignored). This template IS committed.
# ===================================================

# Django Security
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*,localhost,127.0.0.1,.onrender.com,soundpulse-fq3b.onrender.com
PYTHON_VERSION=3.12.0

# CORS (True = allow all Vercel previews; False = strict allow-list below)
CORS_ALLOW_ALL_ORIGINS=True

# CORS & CSRF Whitelist
CORS_ALLOWED_ORIGINS=https://soundpulse-client-1.vercel.app,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://soundpulse-client-1.vercel.app,https://*.vercel.app,https://*.onrender.com,http://localhost:3000,http://localhost:5173

# Database — Render free MUST be sqlite (ephemeral, fine: API is stateless, no models).
# Local XAMPP MySQL optional: DB_ENGINE=mysql + fill below.
DB_ENGINE=sqlite
DB_NAME=soundpulse_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Cloud alternative: DATABASE_URL=mysql://user:pass@host:3306/dbname

# Optional YouTube bot-bypass cookies (Netscape format or path). Leave empty if unused.
YOUTUBE_COOKIES=

# Server Port (Render injects $PORT automatically)
PORT=8000
